+    expect(prefill?.type === 'assistant/message' && prefill.data.message.content).toEqual([{ type: 'text', text: 'forced continuation' }])
+    // The prefill lands between the step's user message and the model response.
+    const order = events(agent).map(event => event.type)
+    expect(order.indexOf('assistant/message')).toBeLessThan(order.indexOf('assistant/chunk'))
